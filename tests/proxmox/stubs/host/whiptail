#!/usr/bin/env python3
"""Test stub for whiptail, driven by scripted answers.

$BULLPEN_TEST_WT_ANSWERS holds one answer per line: "<part of the title> => <answer>".
The answer is printed on stderr like whiptail does. Special answers: <back>
(Cancel/Back/No, exit 1), <esc> (exit 255), <yes> (exit 0), <no> (exit 1).
Message and text boxes need no answer. Every dialog is logged to
$BULLPEN_TEST_STATE/whiptail.log as "kind | title | backtitle | text"."""
import os, sys

state = os.environ["BULLPEN_TEST_STATE"]
args = sys.argv[1:]
kinds = ("--menu", "--inputbox", "--passwordbox", "--yesno", "--msgbox", "--radiolist", "--checklist", "--textbox")
kind = next((a for a in args if a in kinds), "?")
title = args[args.index("--title") + 1] if "--title" in args else ""
back = args[args.index("--backtitle") + 1] if "--backtitle" in args else ""
text = args[args.index(kind) + 1] if kind in args else ""
with open(os.path.join(state, "whiptail.log"), "a") as log:
    log.write(f"{kind[2:]} | {title} | {back} | {text.replace(chr(10), ' / ')}\n")
if kind in ("--msgbox", "--textbox"):
    sys.exit(0)

path = os.environ.get("BULLPEN_TEST_WT_ANSWERS", "")
lines = open(path).read().splitlines() if path and os.path.exists(path) else []
lines = [l for l in lines if l.strip() and not l.startswith("#")]
if not lines:
    with open(os.path.join(state, "whiptail.log"), "a") as log:
        log.write(f"NO ANSWER LEFT for {title}\n")
    sys.exit(255)
expect, _, answer = lines[0].partition(" => ")
with open(path, "w") as f:
    f.write("\n".join(lines[1:]) + "\n")
if expect.strip() not in title:
    with open(os.path.join(state, "whiptail.log"), "a") as log:
        log.write(f"UNEXPECTED DIALOG: wanted '{expect.strip()}', got '{title}'\n")
    sys.exit(255)
codes = {"<back>": 1, "<no>": 1, "<esc>": 255, "<yes>": 0}
if answer in codes:
    sys.exit(codes[answer])
sys.stderr.write(answer)
