#!/usr/bin/env bash
# Test stub for python3: the real Python, except that "python3 -m venv DIR"
# makes a fake environment whose pip installs nothing (and fails when
# BULLPEN_TEST_FAIL_PIP is set). BULLPEN_TEST_PY_VERSION pretends the system
# Python is another version (for the version check).
set -u
real=${BULLPEN_TEST_REAL_PYTHON:?}
if [[ "${1:-}" == -m && "${2:-}" == venv ]]; then
  dir=$3
  mkdir -p "$dir/bin"
  printf '#!/usr/bin/env bash\nexec %q "$@"\n' "$real" >"$dir/bin/python"
  # shellcheck disable=SC2016  # the fake pip expands these itself
  printf '#!/usr/bin/env bash\necho "pip $*" >>"$BULLPEN_TEST_STATE/calls.log"\n%s\n' \
    '[[ -z "${BULLPEN_TEST_FAIL_PIP:-}" ]] || { echo "ERROR: Could not find a version (test stub)"; exit 1; }' >"$dir/bin/pip"
  printf '#!/usr/bin/env bash\necho "uvicorn $*"\n' >"$dir/bin/uvicorn"
  chmod +x "$dir/bin/python" "$dir/bin/pip" "$dir/bin/uvicorn"
  echo "python3 -m venv $dir" >>"$BULLPEN_TEST_STATE/calls.log"
  exit 0
fi
if [[ -n "${BULLPEN_TEST_PY_VERSION:-}" && "${1:-}" == -c && "${2:-}" == *version_info* ]]; then
  if [[ "$2" == *"sys.exit"* ]]; then
    exit 1
  fi
  echo "$BULLPEN_TEST_PY_VERSION"
  exit 0
fi
exec "$real" "$@"
